    <script src="/js/smooth-scroll.min.js"></script>
    <script src="/js/scripts.js?version=1"></script>
    <script>
        var is_root =/^\/(index|index.php)?$/i.test(location.pathname);
        if(!is_root){
            $( document ).ready(function() {
                $('#chemdoodle_ad').attr('class', 'show');
                $(document).mouseup(function (event) {            
                    $('#chemdoodle_ad').attr('class', '');
                });
            });
        }
        // safari loads at the sketcher
        var isSafari = !!navigator.userAgent.match(/Version\/[\d\.]+.*Safari/);
        if(isSafari){
            var iOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
            if(!ChemDoodle.featureDetection.supports_touch()){
                $( document ).ready(function() {
                    window.scroll(0,0);
                });
            }
        }
    </script>
