{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSes",
      "Effect": "Allow",
      "Action": "ses:*",
      "Resource": "*"
    },
    {
      "Sid": "ListTopics",
      "Effect": "Allow",
      "Action": "sns:ListTopics",
      "Resource": "*"
    },
    {
      "Sid": "OnlyTestozaTopics",
      "Effect": "Allow",
      "Action": "sns:*",
      "Resource": "arn:aws:sns:*:*:testoza-*"
    },
    {
      "Sid": "OnlySesSmtpUsers",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:CreateUser",
        "iam:PutUserPolicy",
        "iam:GetUserPolicy",
        "iam:ListAccessKeys",
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:iam::*:user/ses-smtp/*"
    }
  ]
}
