{
    "rewrites": [
        {
            "source": "/api/yt/:path*",
            "destination": "https://www.youtube.com/:path*"
        },
        {
            "source": "/api/parse",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}